# ==========================================
# Lumora Store Environment Variables
# ==========================================

# Resend API for transactional order confirmation emails
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
OWNER_EMAIL=orders@lumorabeauty.com
FROM_EMAIL=orders@lumorabeauty.com

# Optional Webhook for Google Sheets, Zapier, Make, or Telegram notifications
ORDER_WEBHOOK_URL=https://your-webhook-endpoint.com/orders

# Public WhatsApp contact number without '+' or spaces (e.g. 971501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=971501234567

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://lumora.ae

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
