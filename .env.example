# ==========================================
# Lumora Store Environment Variables
# ==========================================

# Resend API for transactional order confirmation emails
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
OWNER_EMAIL=oobishah1@gmail.com
FROM_EMAIL=oobishah1@gmail.com
SUPPORT_EMAIL=oobishah1@gmail.com

# Optional Webhook for Google Sheets, Zapier, Make, or Telegram notifications
ORDER_WEBHOOK_URL=https://your-webhook-endpoint.com/orders

# Public WhatsApp contact number without '+' or spaces (e.g. 923039199321)
NEXT_PUBLIC_WHATSAPP_NUMBER=923039199321

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://marym-store.vercel.app

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
